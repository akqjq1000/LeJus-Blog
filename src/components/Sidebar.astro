---
import { getPosts, slugifyTag } from '../lib/posts';
import { url } from '../lib/site';
const posts = await getPosts();
const counts = new Map<string, number>();
posts.forEach((p) => counts.set(p.data.category, (counts.get(p.data.category) ?? 0) + 1));
const categories = [...counts].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
const recent = posts.slice(0, 5);
---
<aside class="sidebar">
  <section>
    <h3>Categories</h3>
    <ul>
      {categories.map(([c, n]) => (
        <li><a href={url(`/categories/${slugifyTag(c)}/`)}>{c}<span>{n}</span></a></li>
      ))}
    </ul>
  </section>
  <section>
    <h3>Recent posts</h3>
    <ul>
      {recent.map((p) => <li><a href={url(`/posts/${p.id}/`)}>{p.data.title}</a></li>)}
    </ul>
  </section>
</aside>
