---
import Base from '../layouts/Base.astro';
import { url } from '../lib/site';
---
<Base title="404">
  <section class="hero">
    <p class="eyebrow">$ cat ./page<br />cat: ./page: No such file or directory</p>
    <h1>404</h1>
    <p>요청한 페이지를 찾을 수 없습니다. <a href={url('/')} style="color: var(--accent)">홈으로 돌아가기 →</a></p>
  </section>
</Base>
