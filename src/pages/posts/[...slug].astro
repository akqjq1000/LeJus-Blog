---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Sidebar from '../../components/Sidebar.astro';
import { getPosts, slugifyTag, type Post } from '../../lib/posts';
import { url, formatDate, readingTime } from '../../lib/site';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

interface Props { post: Post; newer?: Post; older?: Post }
const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const minutes = readingTime(post.body);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---
<Base title={post.data.title} description={post.data.description} type="article">
  <article>
    <header class="post-header">
      <div class="meta">
        <a class="badge" href={url(`/categories/${slugifyTag(post.data.category)}/`)}>{post.data.category}</a>
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        <span>· {minutes} min read</span>
        {post.data.updated && <span>· 수정 {formatDate(post.data.updated)}</span>}
      </div>
      <h1>{post.data.title}</h1>
      <p class="desc">{post.data.description}</p>
      {post.data.tags.length > 0 && (
        <div class="tags">
          {post.data.tags.map((t) => <a class="tag" href={url(`/tags/${slugifyTag(t)}/`)}>#{t}</a>)}
        </div>
      )}
    </header>
    <div class="prose">
      <Content />
    </div>
    <footer class="post-footer">
      <nav class="post-nav" aria-label="이전/다음 글">
        {older && <a class="prev" href={url(`/posts/${older.id}/`)}><small>← 이전 글</small>{older.data.title}</a>}
        {newer && <a class="next" href={url(`/posts/${newer.id}/`)}><small>다음 글 →</small>{newer.data.title}</a>}
      </nav>
    </footer>
  </article>
  {toc.length > 1 ? (
    <aside class="sidebar toc" slot="aside" aria-label="목차">
      <section>
        <h3>목차</h3>
        <ul>
          {toc.map((h) => (
            <li class={`toc-d${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>
          ))}
        </ul>
      </section>
    </aside>
  ) : <Sidebar slot="aside" />}
</Base>

<script is:inline>
  (() => {
    // 코드 블록: 언어 표시 + 복사 버튼
    document.querySelectorAll('.prose pre').forEach((pre) => {
      const wrap = document.createElement('div');
      wrap.className = 'code-block';
      pre.parentNode.insertBefore(wrap, pre);
      wrap.appendChild(pre);
      const lang = pre.dataset.language;
      if (lang && lang !== 'plaintext') {
        const label = document.createElement('span');
        label.className = 'code-lang';
        label.textContent = lang;
        wrap.appendChild(label);
      }
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'code-copy';
      btn.textContent = '복사';
      btn.setAttribute('aria-label', '코드 복사');
      btn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(pre.innerText.replace(/\n$/, ''));
          btn.textContent = '복사됨';
        } catch {
          btn.textContent = '실패';
        }
        setTimeout(() => { btn.textContent = '복사'; }, 1500);
      });
      wrap.appendChild(btn);
    });

    // 목차: 현재 읽는 위치 표시
    const links = [...document.querySelectorAll('.toc a')];
    if (!links.length || !('IntersectionObserver' in window)) return;
    const map = new Map(links.map((a) => [decodeURIComponent(a.hash.slice(1)), a]));
    const visible = new Set();
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => (e.isIntersecting ? visible.add(e.target.id) : visible.delete(e.target.id)));
      const heads = [...map.keys()].map((id) => document.getElementById(id)).filter(Boolean);
      const current = heads.find((h) => visible.has(h.id)) ??
        heads.filter((h) => h.getBoundingClientRect().top < 100).pop();
      links.forEach((a) => a.removeAttribute('aria-current'));
      if (current) map.get(current.id)?.setAttribute('aria-current', 'true');
    }, { rootMargin: '-80px 0px -60% 0px' });
    map.forEach((_, id) => { const el = document.getElementById(id); if (el) io.observe(el); });
  })();
</script>
