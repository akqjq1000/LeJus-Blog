---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts, slugifyTag, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  const map = new Map<string, { name: string; posts: Post[] }>();
  for (const post of posts) {
    const key = slugifyTag(post.data.category);
    if (!map.has(key)) map.set(key, { name: post.data.category, posts: [] });
    map.get(key)!.posts.push(post);
  }
  return [...map].map(([category, v]) => ({ params: { category }, props: v }));
}

interface Props { name: string; posts: Post[] }
const { name, posts } = Astro.props;
---
<Base title={name} description={`${name} 카테고리의 글`}>
  <section class="hero">
    <p class="eyebrow">$ cd ./categories/{name}</p>
    <h1>{name}</h1>
    <p>{posts.length}개의 글</p>
  </section>
  <ul class="post-list">{posts.map((post) => <PostCard post={post} />)}</ul>
</Base>
